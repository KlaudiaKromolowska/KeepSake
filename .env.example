# Copy to apps/web/.env.local and fill in. Documents shape only — NEVER commit real values.

# Supabase (EU-region project) — public keys, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only — never NEXT_PUBLIC_, never logged (CLAUDE.md code standards)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ANTHROPIC_API_KEY=sk-ant-...

# Demo (optional): >1 compresses wall-clock waits in the session runner.
# Scales UI waiting only — persisted intervals are always real (PLAN.md §8b).
DEMO_SPEED=1
