# Copy to apps/web/.env.local and fill in. Documents shape only — NEVER commit real values.

# Supabase (EU-region project) — public keys, safe for the browser
# For the local stack (`supabase start`; not secrets — the well-known local dev URL/key):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<"Publishable" key from `supabase status`>
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only — never NEXT_PUBLIC_, never logged (CLAUDE.md code standards)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ANTHROPIC_API_KEY=sk-ant-...

# Demo (optional): >1 compresses wall-clock waits in the session runner.
# Scales UI waiting only — persisted intervals are always real (PLAN.md §8b).
DEMO_SPEED=1

# V1 speech assist (optional): set NEXT_PUBLIC_SPEECH=1 to enable speech-graded recall on the
# probe screen (browser ASR → fuzzy match → Haiku fallback; suggestion only — the caregiver tap
# always decides the outcome). Default OFF; leave unset for the demo film flow.
NEXT_PUBLIC_SPEECH=

# Demo login (optional, server-only): set DEMO_MODE=1 to show the one-tap "Enter demo" button
# on /login; it signs in the seeded demo caregiver (demo@keepsake.test) with this password.
# Leave both unset outside demos.
DEMO_MODE=
DEMO_CAREGIVER_PASSWORD=
