{
  "name": "keepsake",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter @keepsake/core --filter web test",
    "test:rls": "pnpm --filter @keepsake/db-tests test",
    "typegen": "supabase gen types typescript --local > apps/web/src/lib/supabase/database.types.ts",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "seed": "tsx scripts/seed.ts",
    "eval:wizard": "tsx --tsconfig apps/web/tsconfig.json scripts/eval-wizard.ts",
    "fixtures:record": "tsx --tsconfig apps/web/tsconfig.json scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@keepsake/core": "workspace:*",
    "@supabase/supabase-js": "2.110.1",
    "@types/node": "^24",
    "lefthook": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "zod": "4.4.3"
  }
}
